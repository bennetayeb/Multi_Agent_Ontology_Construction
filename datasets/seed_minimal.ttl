@prefix : <http://www.semanticweb.org/owl/owlapi/turtle#> .
@prefix EX: <http://example.org/ex#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.semanticweb.org/owl/owlapi/turtle#> .

<http://example.org/ex> rdf:type owl:Ontology ;
                            dct:created "2026-06-10"^^xsd:date ;
                            dct:language "fr" ;
                            rdfs:comment """Ontologies LLMS4Ol"""@fr ;
                            rdfs:label "Ontologies"@fr ;
                            owl:versionInfo "2.0" .


dct:created rdf:type owl:AnnotationProperty .

dct:language rdf:type owl:AnnotationProperty .

dct:modified rdf:type owl:AnnotationProperty .

skos:altLabel rdf:type owl:AnnotationProperty .

xsd:date rdf:type rdfs:Datatype .



<> a owl:Ontology .

owl:Thing a owl:Class ;
    rdfs:label "Thing"@en .
