<http://example.org/plui1> rdf:type owl:Ontology ;
                            dct:created "2025-12-16"^^xsd:date ;
                            dct:language "fr" ;
                            dct:modified "2025-12-16"^^xsd:date ;
                            rdfs:comment """Ontologie structurée du Plan Local d'Urbanisme intercommunal (PLUi). Permet de vérifier la conformité d'un permis de construire par rapport au 
                    règlement de zones."""@fr ;
                            rdfs:label "Ontologie du PLUi"@fr ;
                            owl:versionInfo "2.0" .


dct:created rdf:type owl:AnnotationProperty .

dct:language rdf:type owl:AnnotationProperty .

dct:modified rdf:type owl:AnnotationProperty .

skos:altLabel rdf:type owl:AnnotationProperty .

xsd:date rdf:type rdfs:Datatype .

PLU:aStatutDeConformite rdf:type owl:ObjectProperty ;
                       owl:inverseOf PLU:estStatutDe ;
                       rdfs:domain PLU:PermisDeConstruire ;
                       rdfs:range PLU:StatutConformite ;
                       rdfs:label "a un statut de conformité"@fr .

PLU:destineeA rdf:type owl:ObjectProperty ;
             rdfs:domain PLU:Zone ;
             rdfs:range PLU:Destination ;
             rdfs:comment "Relie une zone à ses destinations autorisées par le règlement du PLUi."@fr ;
             rdfs:label "destinée à"@fr .

PLU:destinéeh rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf PLU:destineeA ;
             rdfs:domain PLU:Aa ;
             rdfs:range PLU:Hebergement .


PLU:estStatutDe rdf:type owl:ObjectProperty ;
               rdfs:domain PLU:StatutConformite ;
               rdfs:range PLU:PermisDeConstruire ;
               rdfs:label "est le statut de"@fr .

PLU:pourdestinations rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain PLU:PermisDeConstruire ;
                    rdfs:range PLU:Destination .

PLU:pourlieux rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain PLU:PermisDeConstruire ;
             rdfs:range PLU:Zone .

