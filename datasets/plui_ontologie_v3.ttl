                                                ] .



PLU:Conforme rdf:type owl:NamedIndividual ,
                     PLU:StatutConformite ;
            rdfs:comment "Le permis de construire est conforme au règlement de la zone."@fr ;
            rdfs:label "Conforme"@fr .


PLU:NonConforme rdf:type owl:NamedIndividual ,
                        PLU:StatutConformite ;
               rdfs:comment "Le permis de construire est non conforme par rapport au règlement du PLUi."@fr ;
